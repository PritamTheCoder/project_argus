# Project Argus - Environment Variables (template)
#
# Copy to .env and fill in real values. Every key below is optional in the
# sense that the pipeline degrades gracefully without it (see src/config.py) —
# but Gemini + at least one high-RPM primary (Groq or GLM) is the realistic
# minimum for a working run.

# ── LLM providers ─────────────────────────────────────────────────────────
# Gemini (Google AI Studio). Used as the last-resort fallback on every node,
# and as the Writer's default when NVIDIA_API_NEMOTRON3_KEY is unset.
GOOGLE_API_KEY=

# Groq. Primary for Librarian/Critic/Verifier/Gatherer (openai/gpt-oss-120b).
# Two keys round-robin for ~2x effective free-tier RPM/TPD; either works alone.
GROQ_API_KEY_A=
GROQ_API_KEY_B=
# Legacy single-key fallback if you only have one Groq key.
GROQ_API_KEY=

# OpenAI (optional — not used by any default node/provider today).
OPENAI_API_KEY=

# NVIDIA NIM (integrate.api.nvidia.com) — one developer account, per-model
# entitlement. The same NVIDIA key can often be reused across the *_NVIDIA_KEY
# vars below; each model still needs to be individually enabled for your
# account at build.nvidia.com if you get a 404 "not found for account".
NVIDIA_API_KEY=
# Nemotron-3-Ultra — Writer's primary reasoning model.
NVIDIA_API_NEMOTRON3_KEY=
# StepFun Step-3.7 (multimodal). Not wired into any default fallback chain.
STEP_3.7_API_KEY=
# Kimi K2.6. NOT used by default (see config.py comment) — this account's key
# may 404 with "not found for account" until Kimi is requested/enabled at
# build.nvidia.com. Safe to leave set; it just won't be selected until then.
KIMI_NVIDIA_KEY=
# Z.AI GLM-5.2 — Refiner's primary, and the first fallback rung everywhere
# else. Model IDs on this line churn every few months (two prior GLM versions
# already went end-of-life) — re-verify against GLM_MODEL in config.py if this
# starts failing.
ZLM_NVIDIA_KEY=

# Reranking (optional). Only needed if the local cross-encoder reranker hits
# HuggingFace Hub rate limits without auth.
HF_TOKEN=

# ── Optional tool-layer keys ─────────────────────────────────────────────
# Brave Search (optional). Unset -> web_search falls back to DuckDuckGo.
BRAVE_API_KEY=
# Semantic Scholar (optional). Unset still works but is rate-limited.
SEMANTIC_SCHOLAR_API_KEY=
# Crossref "polite pool" contact (recommended by Crossref ToS).
CROSSREF_MAILTO=

# ── Search / scraper settings ────────────────────────────────────────────
MAX_SEARCH_RESULTS=5
SCRAPE_TIMEOUT=15
